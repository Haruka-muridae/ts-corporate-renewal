# 環境変数の雛形。
#
# 実際の値はここに書かない。ローカルは .env.local、本番は Vercel の環境変数に
# 登録する（.env* は .gitignore で追跡対象から外してある）。
#
# NEXT_PUBLIC_ が付く変数はブラウザへ配信されるバンドルに埋め込まれる。
# 秘密の値には絶対に付けないこと。
#
# 値を登録するときの注意
#   コピー＆ペーストの経路によっては、先頭にBOM（U+FEFF）や前後の空白・改行が
#   紛れ込むことがある。lib/event/config.mjs が読み取り時に落とすが、
#   登録時にも入れないよう気をつけること。

# ------------------------------------------------------------------
# サイト全体
# ------------------------------------------------------------------

# 承認済みの正規オリジン。パスを含めない（例: https://example.com）。
# TODO: 本番ドメインの承認後に値を入れる。
NEXT_PUBLIC_SITE_URL=

# 公開本番のデプロイだけ "production" にする。
# ローカルビルドとプレビューのデプロイは "preview"。
NEXT_PUBLIC_DEPLOY_ENV=preview

# ------------------------------------------------------------------
# 交流会申込アプリ（app/event/）
# ------------------------------------------------------------------

# 決済後の戻り先URLの土台。交流会アプリのパスまで含める。
# 末尾のスラッシュは付いていても読み取り時に落とされる。
NEXT_PUBLIC_BASE_URL=https://example.com/event

# --- Supabase -----------------------------------------------------

# Project URL。
SUPABASE_URL=https://your-project.supabase.co

# 管理画面のログイン（Supabase Auth）に使う anon キー。
SUPABASE_ANON_KEY=your-anon-key

# 申込の作成・更新・参照に使う service role キー。
# RLSと権限を通過できる唯一のロール。NEXT_PUBLIC_ を付けないこと（受入条件12）。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe -------------------------------------------------------

# Checkout Session の作成に使うシークレットキー。テスト用と本番用で接頭辞が異なる。
#
# 雛形の値は山括弧で書く。実キーと同じ形（接頭辞＋英数字）で書くと、
# ダミーであっても GitHub の push protection が本物と判定して push を止める。
STRIPE_SECRET_KEY=<Stripeのシークレットキー>

# Webhook の署名検証に使う署名シークレット。
# エンドポイントは末尾スラッシュ付きで登録すること（/event/api/stripe/webhook/）。
# スラッシュなしへのPOSTは308リダイレクトになり、Stripe はリダイレクトを
# 追わないため通知が届かない。
STRIPE_WEBHOOK_SECRET=<Stripeの署名シークレット>

# --- 参加確定メール（Gmail API）------------------------------------

# 未設定でも決済は通る。その場合メールは送らず、email_logs に記録だけ残す。
GOOGLE_CLIENT_ID=<末尾が .apps.googleusercontent.com のクライアントID>
GOOGLE_CLIENT_SECRET=<Googleのクライアントシークレット>
GMAIL_REFRESH_TOKEN=<Gmailのリフレッシュトークン>

# 送信元。表示名を付ける場合は "表示名 <address@example.com>" の形。
MAIL_FROM=TSアセットマネジメント合同会社 <noreply@example.com>
