{
  "name": "potenitas-lp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.4.0"
  },
  "overrides": {
    "postcss": "8.5.21",
    "sharp": "0.35.3"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "node public/apps/tests/run.mjs && node tests/run.mjs",
    "test:unit": "node public/apps/tests/run.mjs unit",
    "test:browser": "node public/apps/tests/run.mjs browser",
    "test:auth": "node public/apps/tests/run.mjs auth",
    "test:audit": "node public/apps/tests/run.mjs audit",
    "test:apps": "node public/apps/tests/run.mjs",
    "test:auth-system": "node tests/run.mjs",
    "test:auth-system:unit": "node tests/run.mjs unit",
    "test:auth-system:browser": "node tests/run.mjs browser",
    "test:e2e": "playwright test --project=voice-recorder",
    "test:e2e:soak": "playwright test --project=voice-recorder-soak",
    "test:e2e:soak90": "playwright test --project=voice-recorder-soak90",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:notifier-gate": "wrangler deploy --config workers/notifier-gate/wrangler.jsonc",
    "cf:whoami": "wrangler whoami",
    "cf:versions": "wrangler versions list",
    "check:vendor": "node public/apps/vendor/check-updates.mjs"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.11",
    "postcss": "8.5.21",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.119.0"
  }
}
