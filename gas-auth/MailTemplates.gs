/**
 * メール本文のひな形。
 *
 * 文面を直したいときはこのファイルだけを触る。
 * 送信の仕組み（Mailer.gs）とは分けてある。
 *
 * ------------------------------------------------------------------
 * 本文に入れてはならないもの
 * ------------------------------------------------------------------
 *   パスワード（初期パスワードも含む） / パスワードハッシュ /
 *   セッショントークン / 内部のエラー内容
 *
 * 入れてよいのは、一度きりの一時URLだけ。
 * ------------------------------------------------------------------
 */

/** 有効期限を日本語で書く。 */
function describeExpiry_(expiresAtMs) {
  var remainMs = Math.max(0, expiresAtMs - nowMs_());
  var hours = Math.round(remainMs / (60 * 60 * 1000));

  if (hours >= 1) {
    return 'このリンクは約' + hours + '時間で無効になります。';
  }

  var minutes = Math.max(1, Math.round(remainMs / (60 * 1000)));
  return 'このリンクは約' + minutes + '分で無効になります。';
}

/** 初期パスワード設定の案内。 */
function templateInitialSetup_(url, expiresAtMs) {
  return {
    subject: '【TSAM AI】パスワードの初期設定のご案内',
    body: [
      'TSAM AI をお申し込みいただき、ありがとうございます。',
      '',
      '下記のURLを開き、ログイン用のパスワードを設定してください。',
      '',
      url,
      '',
      describeExpiry_(expiresAtMs),
      '期限が切れた場合は、ログイン画面の「パスワードをお忘れですか？」から再度お手続きください。',
      '',
      'このURLは一度だけ使用できます。心当たりのない場合は、このメールを破棄してください。',
      '',
      '──────────────────────',
      'TSAM AI',
      'TSアセットマネジメント合同会社',
      '──────────────────────'
    ].join('\n')
  };
}

/** パスワード再設定の案内。 */
function templatePasswordReset_(url, expiresAtMs) {
  return {
    subject: '【TSAM AI】パスワード再設定のご案内',
    body: [
      'パスワード再設定のお申し込みを受け付けました。',
      '',
      '下記のURLを開き、新しいパスワードを設定してください。',
      '',
      url,
      '',
      describeExpiry_(expiresAtMs),
      '',
      'このURLは一度だけ使用できます。',
      'お心当たりがない場合は、このメールを破棄してください。',
      'その場合でも、現在のパスワードは変更されません。',
      '',
      '──────────────────────',
      'TSAM AI',
      'TSアセットマネジメント合同会社',
      '──────────────────────'
    ].join('\n')
  };
}

/** パスワード変更の完了通知。 */
function templatePasswordChanged_(loginUrl) {
  return {
    subject: '【TSAM AI】パスワードを変更しました',
    body: [
      'ご登録のアカウントのパスワードを変更しました。',
      '',
      'あわせて、これまでのログイン状態はすべて解除されています。',
      'お手数ですが、下記より改めてログインしてください。',
      '',
      loginUrl,
      '',
      'お心当たりがない場合は、速やかに管理者へご連絡ください。',
      '',
      '──────────────────────',
      'TSAM AI',
      'TSアセットマネジメント合同会社',
      '──────────────────────'
    ].join('\n')
  };
}
